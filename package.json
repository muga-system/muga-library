{
  "name": "muga-books-register",
  "version": "1.0.0",
  "description": "Sistema de Gestión Bibliotecaria - Modernización J-ISIS UNESCO",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start-hostinger.mjs",
    "lint": "eslint . --quiet",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:backup": "node scripts/backup-data.mjs",
    "db:restore": "node scripts/restore-data.mjs",
    "db:convert-aguapey": "node scripts/convert-aguapey-iso.mjs",
    "db:convert-aguapey-mst": "node scripts/convert-aguapey-mst.mjs",
    "db:import-aguapey": "node scripts/import-aguapey-full.mjs",
    "covers:enrich": "node scripts/enrich-book-covers.mjs"
  },
  "keywords": [
    "library",
    "isis",
    "marc",
    "bibliotecario",
    "educacion"
  ],
  "author": "MUGA",
  "engines": {
    "node": ">=22.5.0 <23"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "file:vendor/drizzle-sqlite-client-shim",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "0.8.2",
    "lucide-react": "^1.0.1",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.3",
    "postcss": "8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}
