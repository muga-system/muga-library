# Server-side SQLite database and uploads
DATABASE_URL=file:./data/muga-library.db
UPLOADS_DIR=./data/uploads

# Optional admin bootstrap endpoint
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_SECRET=generate_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password

# Email notifications (Hostinger Mail API)
HOSTINGER_EMAIL_API_URL=https://api.mail.hostinger.com
HOSTINGER_EMAIL_API_TOKEN=
HOSTINGER_MAILBOX_RESOURCE_ID=
HOSTINGER_MAIL_DISPLAY_NAME=MUGA
COUPON_REQUEST_NOTIFICATION_EMAIL=bibliotecas@muga.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
