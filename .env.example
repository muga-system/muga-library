# Server-side SQLite database and uploads
DATABASE_URL=file:./data/muga-library.db
UPLOADS_DIR=./data/uploads

# Optional admin bootstrap endpoint
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_SECRET=generate_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password

# Email notifications (Resend)
RESEND_API_KEY=
EMAIL_FROM=
COUPON_REQUEST_NOTIFICATION_EMAIL=admin@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
